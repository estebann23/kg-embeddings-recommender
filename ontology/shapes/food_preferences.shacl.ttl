@prefix fp: <https://github.com/estebann23/kg-embeddings-recommender/ontology/food_preferences#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

fp:EntityShape a sh:NodeShape ;
    sh:targetClass fp:ObservedUser, fp:ScenarioProfile, fp:Recipe, fp:Ingredient,
        fp:FoodOnConcept, fp:DietaryPattern, fp:Allergen ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:pattern "\\S" ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ] .

fp:RecipeShape a sh:NodeShape ; sh:targetClass fp:Recipe ;
    sh:property [ sh:path fp:compositionComplete ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path fp:servingSizeGrams ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path fp:calories ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path fp:totalFatGrams ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path fp:saturatedFatGrams ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path fp:cholesterolMilligrams ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path fp:sodiumMilligrams ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path fp:carbohydrateGrams ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path fp:dietaryFiberGrams ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path fp:sugarsGrams ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path fp:proteinGrams ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:sparql [ sh:message "A recipe cannot have both positive and negative assessments for one diet." ;
        sh:select """
            PREFIX fp: <https://github.com/estebann23/kg-embeddings-recommender/ontology/food_preferences#>
            SELECT $this WHERE { $this fp:compatibleWithDiet ?diet ; fp:incompatibleWithDiet ?diet . }
        """ ] .

fp:RecipeNutritionSubjectShape a sh:NodeShape ;
    sh:targetSubjectsOf fp:servingSizeGrams, fp:calories, fp:totalFatGrams,
        fp:saturatedFatGrams, fp:cholesterolMilligrams, fp:sodiumMilligrams,
        fp:carbohydrateGrams, fp:dietaryFiberGrams, fp:sugarsGrams,
        fp:proteinGrams, fp:compositionComplete ;
    sh:class fp:Recipe .

fp:ScenarioProfileShape a sh:NodeShape ; sh:targetClass fp:ScenarioProfile ;
    sh:property [ sh:path fp:scenarioFor ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ; sh:class fp:ObservedUser ] ;
    sh:or (
        [ sh:property [ sh:path fp:requiresDiet ; sh:minCount 1 ] ]
        [ sh:property [ sh:path fp:allergicTo ; sh:minCount 1 ] ]
        [ sh:property [ sh:path fp:mustAvoid ; sh:minCount 1 ] ]
    ) .

fp:ratedShape a sh:NodeShape ; sh:targetSubjectsOf fp:rated ;
    sh:class fp:ObservedUser ;
    sh:property [ sh:path fp:rated ; sh:nodeKind sh:IRI ; sh:class fp:Recipe ] .

fp:scenarioForShape a sh:NodeShape ; sh:targetSubjectsOf fp:scenarioFor ;
    sh:class fp:ScenarioProfile ;
    sh:property [ sh:path fp:scenarioFor ; sh:nodeKind sh:IRI ; sh:class fp:ObservedUser ] .

fp:containsShape a sh:NodeShape ; sh:targetSubjectsOf fp:contains ;
    sh:class fp:Recipe ;
    sh:property [ sh:path fp:contains ; sh:nodeKind sh:IRI ; sh:class fp:Ingredient ] .

fp:mapsToFoodOnShape a sh:NodeShape ; sh:targetSubjectsOf fp:mapsToFoodOn ;
    sh:class fp:Ingredient ;
    sh:property [ sh:path fp:mapsToFoodOn ; sh:nodeKind sh:IRI ; sh:class fp:FoodOnConcept ] .

fp:foodOnSubClassOfShape a sh:NodeShape ; sh:targetSubjectsOf fp:foodOnSubClassOf ;
    sh:class fp:FoodOnConcept ;
    sh:property [ sh:path fp:foodOnSubClassOf ; sh:nodeKind sh:IRI ; sh:class fp:FoodOnConcept ] .

fp:requiresDietShape a sh:NodeShape ; sh:targetSubjectsOf fp:requiresDiet ;
    sh:class fp:ScenarioProfile ;
    sh:property [ sh:path fp:requiresDiet ; sh:nodeKind sh:IRI ; sh:class fp:DietaryPattern ] .

fp:allergicToShape a sh:NodeShape ; sh:targetSubjectsOf fp:allergicTo ;
    sh:class fp:ScenarioProfile ;
    sh:property [ sh:path fp:allergicTo ; sh:nodeKind sh:IRI ; sh:class fp:Allergen ] .

fp:mustAvoidShape a sh:NodeShape ; sh:targetSubjectsOf fp:mustAvoid ;
    sh:class fp:ScenarioProfile ;
    sh:property [ sh:path fp:mustAvoid ; sh:nodeKind sh:IRI ; sh:class fp:Ingredient ] .

fp:hasAllergenShape a sh:NodeShape ; sh:targetSubjectsOf fp:hasAllergen ;
    sh:class fp:Ingredient ;
    sh:property [ sh:path fp:hasAllergen ; sh:nodeKind sh:IRI ; sh:class fp:Allergen ] .

fp:excludesIngredientShape a sh:NodeShape ; sh:targetSubjectsOf fp:excludesIngredient ;
    sh:class fp:DietaryPattern ;
    sh:property [ sh:path fp:excludesIngredient ; sh:nodeKind sh:IRI ; sh:class fp:Ingredient ] .

fp:excludesAllergenShape a sh:NodeShape ; sh:targetSubjectsOf fp:excludesAllergen ;
    sh:class fp:DietaryPattern ;
    sh:property [ sh:path fp:excludesAllergen ; sh:nodeKind sh:IRI ; sh:class fp:Allergen ] .

fp:compatibleWithDietShape a sh:NodeShape ; sh:targetSubjectsOf fp:compatibleWithDiet ;
    sh:class fp:Recipe ;
    sh:property [ sh:path fp:compatibleWithDiet ; sh:nodeKind sh:IRI ; sh:class fp:DietaryPattern ] .

fp:incompatibleWithDietShape a sh:NodeShape ; sh:targetSubjectsOf fp:incompatibleWithDiet ;
    sh:class fp:Recipe ;
    sh:property [ sh:path fp:incompatibleWithDiet ; sh:nodeKind sh:IRI ; sh:class fp:DietaryPattern ] .

fp:StatementShape a sh:NodeShape ;
    sh:targetClass rdf:Statement ;
    sh:targetSubjectsOf fp:evidenceState, fp:sourceText, fp:ratingValue ;
    sh:class rdf:Statement ; sh:nodeKind sh:IRI ;
    sh:property [ sh:path rdf:subject ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rdf:predicate ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in (fp:rated fp:scenarioFor fp:contains fp:mapsToFoodOn fp:foodOnSubClassOf fp:requiresDiet fp:allergicTo fp:mustAvoid fp:hasAllergen fp:excludesIngredient fp:excludesAllergen fp:compatibleWithDiet fp:incompatibleWithDiet) ] ;
    sh:property [ sh:path rdf:object ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path fp:evidenceState ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:in ("CONFIRMED" "INFERRED" "MAY_CONTAIN" "UNKNOWN") ] ;
    sh:property [ sh:path dcterms:source ; sh:minCount 1 ;
        sh:or ( [ sh:nodeKind sh:IRI ] [ sh:datatype xsd:string ; sh:pattern "\\S" ] ) ] ;
    sh:property [ sh:path fp:sourceText ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path fp:ratingValue ; sh:maxCount 1 ; sh:datatype xsd:integer ;
        sh:minInclusive 1 ; sh:maxInclusive 5 ] ;
    sh:sparql [ sh:message "Statement must describe an existing direct relationship triple." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this WHERE {
                $this rdf:subject ?s ; rdf:predicate ?p ; rdf:object ?o .
                FILTER NOT EXISTS { ?s ?p ?o . }
            }
        """ ] ;
    sh:sparql [ sh:message "Only rated statements have a required 1–5 rating." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX fp: <https://github.com/estebann23/kg-embeddings-recommender/ontology/food_preferences#>
            SELECT $this WHERE {
                $this rdf:predicate ?p .
                OPTIONAL { $this fp:ratingValue ?rating . }
                FILTER ((?p = fp:rated && !BOUND(?rating)) || (?p != fp:rated && BOUND(?rating)))
            }
        """ ] ;
    sh:sparql [ sh:message "MAY_CONTAIN is only possible ingredient or allergen presence." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX fp: <https://github.com/estebann23/kg-embeddings-recommender/ontology/food_preferences#>
            SELECT $this WHERE {
                $this rdf:predicate ?p ; fp:evidenceState "MAY_CONTAIN" .
                FILTER (?p NOT IN (fp:contains, fp:hasAllergen))
            }
        """ ] .

fp:RelationshipMetadataShape a sh:NodeShape ;
    sh:targetSubjectsOf fp:rated, fp:scenarioFor, fp:contains, fp:mapsToFoodOn, fp:foodOnSubClassOf, fp:requiresDiet, fp:allergicTo, fp:mustAvoid, fp:hasAllergen, fp:excludesIngredient, fp:excludesAllergen, fp:compatibleWithDiet, fp:incompatibleWithDiet ;
    sh:sparql [ sh:message "Every relationship needs typed statement evidence and source." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX fp: <https://github.com/estebann23/kg-embeddings-recommender/ontology/food_preferences#>
            SELECT $this ?path ?value WHERE {
                $this ?path ?value .
                FILTER (?path IN (fp:rated, fp:scenarioFor, fp:contains, fp:mapsToFoodOn, fp:foodOnSubClassOf, fp:requiresDiet, fp:allergicTo, fp:mustAvoid, fp:hasAllergen, fp:excludesIngredient, fp:excludesAllergen, fp:compatibleWithDiet, fp:incompatibleWithDiet))
                FILTER NOT EXISTS {
                    ?record a rdf:Statement ; rdf:subject $this ;
                        rdf:predicate ?path ; rdf:object ?value .
                }
            }
        """ ] .
