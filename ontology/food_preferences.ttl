@prefix fp: <https://github.com/estebann23/kg-embeddings-recommender/ontology/food_preferences#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://github.com/estebann23/kg-embeddings-recommender/ontology/food_preferences>
    a owl:Ontology ;
    dcterms:title "Recipe recommendation vocabulary"@en ;
    dcterms:description "Recipe-level evidence and separate fictional dietary/allergy scenarios, as specified in description.md."@en ;
    owl:versionInfo "0.2.0" .

fp:ObservedUser a owl:Class ; rdfs:label "Observed user"@en ;
    rdfs:comment "A HUMMUS member with recorded user–recipe interactions, not inferred health requirements."@en .
fp:ScenarioProfile a owl:Class ; rdfs:label "Scenario profile"@en ;
    rdfs:comment "A fictional, explicitly specified dietary or allergy scenario."@en .
fp:Recipe a owl:Class ; rdfs:label "Recipe"@en ;
    rdfs:comment "The item being recommended, with sourced ingredient and nutrition information."@en .
fp:Ingredient a owl:Class ; rdfs:label "Ingredient"@en ;
    rdfs:comment "A mapped ingredient identity; an unverified mapping preserves its uncertainty."@en .
fp:FoodOnConcept a owl:Class ; rdfs:label "FoodOn concept"@en ;
    rdfs:comment "A FoodOn class retaining the external ontology IRI."@en .
fp:DietaryPattern a owl:Class ; rdfs:label "Dietary pattern"@en ;
    rdfs:comment "An explicit scenario diet with documented exclusion rules."@en .
fp:Allergen a owl:Class ; rdfs:label "Allergen"@en ;
    rdfs:comment "An allergen category used in a documented scenario rule."@en .

fp:constraintKind a owl:AnnotationProperty ; rdfs:label "Constraint kind"@en .

fp:rated a owl:ObjectProperty ; rdfs:domain fp:ObservedUser ; rdfs:range fp:Recipe ;
    fp:constraintKind "fact" ; rdfs:label "Rated"@en ;
    rdfs:comment "An observed training review; the rating is on its evidence statement."@en .
fp:scenarioFor a owl:ObjectProperty ; rdfs:domain fp:ScenarioProfile ; rdfs:range fp:ObservedUser ;
    fp:constraintKind "fact" ; rdfs:label "Scenario for"@en ;
    rdfs:comment "Associates a fictional scenario with an observed profile for evaluation; asserts no real diagnosis."@en .
fp:contains a owl:ObjectProperty ; rdfs:domain fp:Recipe ; rdfs:range fp:Ingredient ;
    fp:constraintKind "fact" ; rdfs:label "Contains declared ingredient"@en ;
    rdfs:comment "Declared recipe ingredient with evidence state; it does not establish complete composition."@en .
fp:mapsToFoodOn a owl:ObjectProperty ; rdfs:domain fp:Ingredient ; rdfs:range fp:FoodOnConcept ;
    fp:constraintKind "fact" ; rdfs:label "Maps to FoodOn"@en ;
    rdfs:comment "Sourced FoodKG-to-FoodOn mapping with uncertainty retained."@en .
fp:foodOnSubClassOf a owl:ObjectProperty ; rdfs:domain fp:FoodOnConcept ; rdfs:range fp:FoodOnConcept ;
    fp:constraintKind "fact" ; rdfs:label "FoodOn subclass of"@en ;
    rdfs:comment "A named-class FoodOn rdfs:subClassOf triple, retaining its source."@en .
fp:requiresDiet a owl:ObjectProperty ; rdfs:domain fp:ScenarioProfile ; rdfs:range fp:DietaryPattern ;
    fp:constraintKind "hard" ; rdfs:label "Requires diet"@en ;
    rdfs:comment "Explicit scenario requirement, never derived from a HUMMUS rating."@en .
fp:allergicTo a owl:ObjectProperty ; rdfs:domain fp:ScenarioProfile ; rdfs:range fp:Allergen ;
    fp:constraintKind "hard" ; rdfs:label "Allergic to"@en ;
    rdfs:comment "Explicit fictional allergy constraint."@en .
fp:mustAvoid a owl:ObjectProperty ; rdfs:domain fp:ScenarioProfile ; rdfs:range fp:Ingredient ;
    fp:constraintKind "hard" ; rdfs:label "Must avoid"@en ;
    rdfs:comment "Explicit ingredient exclusion in a scenario."@en .
fp:hasAllergen a owl:ObjectProperty ; rdfs:domain fp:Ingredient ; rdfs:range fp:Allergen ;
    fp:constraintKind "fact" ; rdfs:label "Has allergen"@en ;
    rdfs:comment "Documented ingredient-to-allergen rule, not supplied by a FoodOn mapping alone."@en .
fp:excludesIngredient a owl:ObjectProperty ; rdfs:domain fp:DietaryPattern ; rdfs:range fp:Ingredient ;
    fp:constraintKind "rule" ; rdfs:label "Excludes ingredient"@en ;
    rdfs:comment "Documented diet exclusion rule."@en .
fp:excludesAllergen a owl:ObjectProperty ; rdfs:domain fp:DietaryPattern ; rdfs:range fp:Allergen ;
    fp:constraintKind "rule" ; rdfs:label "Excludes allergen"@en ;
    rdfs:comment "Documented diet exclusion rule."@en .
fp:compatibleWithDiet a owl:ObjectProperty ; rdfs:domain fp:Recipe ; rdfs:range fp:DietaryPattern ;
    fp:constraintKind "fact" ; rdfs:label "Compatible with diet"@en ;
    rdfs:comment "Independent checked compatibility assessment, not inferred from missing edges."@en .
fp:incompatibleWithDiet a owl:ObjectProperty ; rdfs:domain fp:Recipe ; rdfs:range fp:DietaryPattern ;
    fp:constraintKind "fact" ; rdfs:label "Incompatible with diet"@en ;
    rdfs:comment "Evidence-backed recipe–diet conflict."@en .

# A direct object-property triple is accompanied by a named rdf:Statement.
fp:evidenceState a owl:DatatypeProperty ; rdfs:domain rdf:Statement ; rdfs:range xsd:string .
fp:sourceText a owl:DatatypeProperty ; rdfs:domain rdf:Statement ; rdfs:range xsd:string .
fp:ratingValue a owl:DatatypeProperty ; rdfs:domain rdf:Statement ; rdfs:range xsd:integer ;
    rdfs:comment "Observed rating 1–5, present only on rated statements."@en .
fp:compositionComplete a owl:DatatypeProperty ; rdfs:domain fp:Recipe ; rdfs:range xsd:boolean ;
    rdfs:comment "True only after explicit verification; absence does not certify safety."@en .
fp:servingSizeGrams a owl:DatatypeProperty ; rdfs:domain fp:Recipe ; rdfs:range xsd:decimal .
fp:calories a owl:DatatypeProperty ; rdfs:domain fp:Recipe ; rdfs:range xsd:decimal .
fp:totalFatGrams a owl:DatatypeProperty ; rdfs:domain fp:Recipe ; rdfs:range xsd:decimal .
fp:saturatedFatGrams a owl:DatatypeProperty ; rdfs:domain fp:Recipe ; rdfs:range xsd:decimal .
fp:cholesterolMilligrams a owl:DatatypeProperty ; rdfs:domain fp:Recipe ; rdfs:range xsd:decimal .
fp:sodiumMilligrams a owl:DatatypeProperty ; rdfs:domain fp:Recipe ; rdfs:range xsd:decimal .
fp:carbohydrateGrams a owl:DatatypeProperty ; rdfs:domain fp:Recipe ; rdfs:range xsd:decimal .
fp:dietaryFiberGrams a owl:DatatypeProperty ; rdfs:domain fp:Recipe ; rdfs:range xsd:decimal .
fp:sugarsGrams a owl:DatatypeProperty ; rdfs:domain fp:Recipe ; rdfs:range xsd:decimal .
fp:proteinGrams a owl:DatatypeProperty ; rdfs:domain fp:Recipe ; rdfs:range xsd:decimal .
