@prefix fp: <https://github.com/estebann23/kg-embeddings-recommender/ontology/food_preferences#> .
@prefix ex: <https://github.com/estebann23/kg-embeddings-recommender/entity/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

ex:user_1 a fp:ObservedUser ; rdfs:label "Observed test user"@en .
ex:scenario_1 a fp:ScenarioProfile ; rdfs:label "Fictional tree-nut restriction"@en ;
    dcterms:source <urn:fixture:scenario> .
ex:recipe_1 a fp:Recipe ; rdfs:label "Almond recipe"@en ;
    fp:calories "240.0"^^xsd:decimal ;
    fp:totalFatGrams "12.0"^^xsd:decimal .
ex:recipe_2 a fp:Recipe ; rdfs:label "Chickpea recipe"@en .
ex:almond a fp:Ingredient ; rdfs:label "Almond"@en .
ex:chickpea a fp:Ingredient ; rdfs:label "Chickpea"@en .
<https://example.org/fixture/foodon/almond_product> a fp:FoodOnConcept ;
    rdfs:label "Synthetic almond product class"@en .
<https://example.org/fixture/foodon/food_product> a fp:FoodOnConcept ;
    rdfs:label "Synthetic food product class"@en .
ex:tree_nut a fp:Allergen ; rdfs:label "Tree nut"@en .
ex:vegan a fp:DietaryPattern ; rdfs:label "Vegan"@en .

ex:user_1 fp:rated ex:recipe_1 .
ex:recipe_statement_001 a rdf:Statement ;
    rdf:subject ex:user_1 ; rdf:predicate fp:rated ; rdf:object ex:recipe_1 ;
    fp:evidenceState "CONFIRMED" ; dcterms:source <urn:fixture:recipe-level> ; fp:ratingValue 5 .

ex:scenario_1 fp:scenarioFor ex:user_1 .
ex:recipe_statement_002 a rdf:Statement ;
    rdf:subject ex:scenario_1 ; rdf:predicate fp:scenarioFor ; rdf:object ex:user_1 ;
    fp:evidenceState "CONFIRMED" ; dcterms:source <urn:fixture:recipe-level> .

ex:scenario_1 fp:allergicTo ex:tree_nut .
ex:recipe_statement_003 a rdf:Statement ;
    rdf:subject ex:scenario_1 ; rdf:predicate fp:allergicTo ; rdf:object ex:tree_nut ;
    fp:evidenceState "CONFIRMED" ; dcterms:source <urn:fixture:recipe-level> .

ex:recipe_1 fp:contains ex:almond .
ex:recipe_statement_004 a rdf:Statement ;
    rdf:subject ex:recipe_1 ; rdf:predicate fp:contains ; rdf:object ex:almond ;
    fp:evidenceState "CONFIRMED" ; dcterms:source <urn:fixture:recipe-level> .

ex:recipe_2 fp:contains ex:chickpea .
ex:recipe_statement_005 a rdf:Statement ;
    rdf:subject ex:recipe_2 ; rdf:predicate fp:contains ; rdf:object ex:chickpea ;
    fp:evidenceState "INFERRED" ; dcterms:source <urn:fixture:recipe-level> .

ex:almond fp:mapsToFoodOn <https://example.org/fixture/foodon/almond_product> .
ex:recipe_statement_006 a rdf:Statement ;
    rdf:subject ex:almond ; rdf:predicate fp:mapsToFoodOn ; rdf:object <https://example.org/fixture/foodon/almond_product> ;
    fp:evidenceState "INFERRED" ; dcterms:source <urn:fixture:recipe-level> .

<https://example.org/fixture/foodon/almond_product> fp:foodOnSubClassOf <https://example.org/fixture/foodon/food_product> .
ex:recipe_statement_007 a rdf:Statement ;
    rdf:subject <https://example.org/fixture/foodon/almond_product> ; rdf:predicate fp:foodOnSubClassOf ; rdf:object <https://example.org/fixture/foodon/food_product> ;
    fp:evidenceState "CONFIRMED" ; dcterms:source <urn:fixture:recipe-level> .

ex:almond fp:hasAllergen ex:tree_nut .
ex:recipe_statement_008 a rdf:Statement ;
    rdf:subject ex:almond ; rdf:predicate fp:hasAllergen ; rdf:object ex:tree_nut ;
    fp:evidenceState "CONFIRMED" ; dcterms:source <urn:fixture:recipe-level> .

ex:scenario_1 fp:requiresDiet ex:vegan .
ex:recipe_statement_009 a rdf:Statement ;
    rdf:subject ex:scenario_1 ; rdf:predicate fp:requiresDiet ; rdf:object ex:vegan ;
    fp:evidenceState "CONFIRMED" ; dcterms:source <urn:fixture:recipe-level> .

ex:vegan fp:excludesIngredient ex:almond .
ex:recipe_statement_010 a rdf:Statement ;
    rdf:subject ex:vegan ; rdf:predicate fp:excludesIngredient ; rdf:object ex:almond ;
    fp:evidenceState "CONFIRMED" ; dcterms:source <urn:fixture:recipe-level> .
